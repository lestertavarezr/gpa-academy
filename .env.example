# Copia este archivo a .env y llena tus valores reales.
# .env esta en .gitignore — nunca se sube al repo. NUNCA pegues estos
# valores en el chat de Claude ni en ningun commit.

# Token de acceso de larga duracion (60 dias) de la Instagram Graph API.
# Se obtiene siguiendo INSTAGRAM_SETUP.md
IG_ACCESS_TOKEN=

# ID numerico de tu cuenta de Instagram profesional (Business/Creator).
# Se obtiene en el paso 5 de INSTAGRAM_SETUP.md
IG_BUSINESS_ID=
