# Copia este archivo a ".env" y reemplaza los valores antes de levantar los contenedores.
# Nunca subas el archivo ".env" real (con la contraseña real) a GitHub.

# El subdominio donde vivira n8n. Debe apuntar (registro DNS tipo A) a la IP de este servidor.
N8N_HOST=n8n.tudominio.com

# Credenciales de la base de datos Postgres compartida (uso interno de n8n + tablas gpa_inscripciones/gpa_log)
POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia-esta-clave-por-una-segura
POSTGRES_DB=n8n

# Credenciales de Pagadito (uid/wsk) para crear links de pago dinamicos por API.
# Se sacan del panel de Pagadito -> Configuracion -> Credenciales de Conexion.
# NUNCA subas el archivo .env real (con los valores reales) a GitHub.
PAGADITO_UID=tu-uid-de-pagadito
PAGADITO_WSK=tu-wsk-de-pagadito
# true = usa el ambiente de pruebas de Pagadito (no cobra de verdad). Cambia a false cuando ya probaste que funciona.
PAGADITO_SANDBOX=true
