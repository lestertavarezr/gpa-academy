    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO gpa_inscripciones (nombre, cedula, pais, telefono, email, programa, estado, creado_en)\nVALUES ($1, $2, $3, $4, $5, $6, $7, NOW())\nON CONFLICT (email) DO UPDATE SET\n  nombre = EXCLUDED.nombre,\n  cedula = EXCLUDED.cedula,\n  pais = EXCLUDED.pais,\n  telefono = EXCLUDED.telefono,\n  programa = EXCLUDED.programa,\n  estado = EXCLUDED.estado,\n  creado_en = NOW()\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [$json.nombre, $json.cedula, $json.pais, $json.telefono, $json.email, $json.programa, $json.estado] }}"
        }
      },
      "id": "42ff66e9-9e81-41de-9257-5623e5eda9e4",
      "name": "Guardar Inscripcion",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        780,
        0
      ],
      "onError": "continueErrorOutput",
      "credentials": {
        "postgres": {
          "id": "TODO",
          "name": "Postgres GPA Academy"
        }
      }
    },
