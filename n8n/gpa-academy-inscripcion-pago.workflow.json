        "assignments": {
          "assignments": [
            {
              "id": "8224f0fc-17c5-43a6-beac-9f744ef2eeec",
              "name": "email_referencia",
              "type": "string",
              "value": "={{ ($json.body.email || $json.body.customer_email || $json.body.custom1 || '').toLowerCase().trim() }}"
            },
            {
              "id": "387ddb96-42a1-4b5c-ab93-2edee046b0f0",
              "name": "telefono_referencia",
              "type": "string",
              "value": "={{ $json.body.telefono || $json.body.phone || $json.body.custom2 || '' }}"
            },
            {
              "id": "7c68c0ea-e487-4da1-ae08-b95fc719de2c",
              "name": "monto",
              "type": "string",
              "value": "={{ $json.body.amount || $json.body.monto || $json.body.total || '' }}"
            },
            {
              "id": "cfd388ba-8152-471a-995f-5af1fe1bf1f2",
              "name": "estado_pago",
              "type": "string",
              "value": "={{ $json.body.status || $json.body.STATUS || $json.body.ps_status || '' }}"
            },
            {
              "id": "7589e91c-cb38-4901-b44b-ba8a1ba6ad67",
              "name": "referencia_pago",
              "type": "string",
              "value": "={{ $json.body.ern || $json.body.reference || $json.body.transaction_id || $json.body.token || '' }}"
            },
            {
              "id": "2b7a72c1-b42d-4007-b401-c06de092df2e",
              "name": "fecha_pago",
              "type": "string",
              "value": "={{ $now.toISO() }}"
            },
            {
              "id": "8d4bb151-0fe1-4a4a-8913-a6a3bb2a5ba1",
              "name": "pago_confirmado_bool",
              "type": "boolean",
              "value": "={{ ['confirmado','completado','completed','success','approved','completo','pagado','ok'].includes( (($json.body.status || $json.body.STATUS || $json.body.ps_status || '') + '').toLowerCase() ) }}"
            }
          ]
        },
        "options": {}
